// ---- Photo & persistence helpers (shared by outfits, journal, memory book, people) ----
function lvdGet(key, fallback) {
  try { var v = localStorage.getItem(key); return v ? JSON.parse(v) : fallback; }
  catch(e) { return fallback; }
}
function lvdSet(key, val) {
  try {
    var str = JSON.stringify(val);
    localStorage.setItem(key, str);
    fbPushKey(key, str);
    return true;
  }
  catch(e) { alert('Photo storage is full on this device. Try removing an older photo before adding more.'); return false; }
}
function lvdPhotos(ns) { return lvdGet('lvd_photos_' + ns, []); }
function lvdPhotoThumbsHtml(ns) {
  var photos = lvdPhotos(ns);
  return photos.map(function(src, idx) {
    return '<div style="position:relative;display:inline-block;margin:2px">'
      + '<img src="' + src + '" style="width:48px;height:48px;object-fit:cover;border-radius:7px;border:2px solid var(--b);display:block">'
      + '<div onclick="event.stopPropagation();lvdRemovePhoto(\'' + ns + '\',' + idx + ')" style="position:absolute;top:-5px;right:-5px;width:16px;height:16px;background:#dc2626;color:white;border-radius:50%;font-size:10px;display:flex;align-items:center;justify-content:center;cursor:pointer;line-height:1;box-shadow:0 1px 3px rgba(0,0,0,.3)">\u00d7</div>'
      + '</div>';
  }).join('');
}
function lvdRemovePhoto(ns, idx) {
  var photos = lvdPhotos(ns);
  photos.splice(idx, 1);
  lvdSet('lvd_photos_' + ns, photos);
  var refreshFn = lvdPhotoRefreshers[ns];
  if (refreshFn) refreshFn();
}
function lvdCompressImage(dataUrl, cb) {
  // Downscale + re-encode as JPEG so photos take a fraction of the raw camera-file size,
  // which is what was blowing through localStorage's quota on-device.
  try {
    var img = new Image();
    img.onload = function() {
      var maxDim = 1000;
      var w = img.width, h = img.height;
      if (w > maxDim || h > maxDim) {
        if (w >= h) { h = Math.round(h * (maxDim / w)); w = maxDim; }
        else { w = Math.round(w * (maxDim / h)); h = maxDim; }
      }
      var canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      var ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, w, h);
      var out;
      try { out = canvas.toDataURL('image/jpeg', 0.72); } catch(e) { out = dataUrl; }
      cb(out || dataUrl);
    };
    img.onerror = function() { cb(dataUrl); };
    img.src = dataUrl;
  } catch(e) { cb(dataUrl); }
}
function lvdAddPhotos(ns, files, cb) {
  if (!files || !files.length) { if (cb) cb(); return; }
  var photos = lvdPhotos(ns);
  var remaining = files.length;
  Array.from(files).forEach(function(f) {
    var r = new FileReader();
    r.onload = function(e) {
      lvdCompressImage(e.target.result, function(compressed) {
        photos.push(compressed);
        remaining--;
        if (remaining === 0) { lvdSet('lvd_photos_' + ns, photos); if (cb) cb(); }
      });
    };
    r.readAsDataURL(f);
  });
}
var lvdPhotoRefreshers = {}; // ns -> function that re-renders that photo strip in place

function poolFilesSelected(trip, who, files){
  var ns = 'outfit_pool_' + trip + '_' + who;
