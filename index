function pad2(n){ return n < 10 ? '0'+n : ''+n; }

function calcSunTimes(dateObj, lat, lon){
  var rad = Math.PI/180;
  var startOfYear = new Date(Date.UTC(dateObj.getUTCFullYear(), 0, 1));
  var dayOfYearVal = Math.floor((Date.UTC(dateObj.getUTCFullYear(), dateObj.getUTCMonth(), dateObj.getUTCDate()) - startOfYear.getTime()) / 86400000) + 1;
  var zenith = 90.833;
  function calc(isSunrise){
    var lngHour = lon / 15;
    var t = isSunrise ? dayOfYearVal + ((6 - lngHour) / 24) : dayOfYearVal + ((18 - lngHour) / 24);
    var M = (0.9856 * t) - 3.289;
    var L = M + (1.916 * Math.sin(rad * M)) + (0.020 * Math.sin(rad * 2 * M)) + 282.634;
    L = (L + 360) % 360;
    var RA = (1 / rad) * Math.atan(0.91764 * Math.tan(rad * L));
    RA = (RA + 360) % 360;
    var Lq = Math.floor(L / 90) * 90;
    var RAq = Math.floor(RA / 90) * 90;
    RA = (RA + (Lq - RAq)) / 15;
    var sinDec = 0.39782 * Math.sin(rad * L);
    var cosDec = Math.cos(Math.asin(sinDec));
    var cosH = (Math.cos(rad * zenith) - (sinDec * Math.sin(rad * lat))) / (cosDec * Math.cos(rad * lat));
    if(cosH > 1 || cosH < -1) return null;
    var H = isSunrise ? 360 - (1 / rad) * Math.acos(cosH) : (1 / rad) * Math.acos(cosH);
    H = H / 15;
    var T = H + RA - (0.06571 * t) - 6.622;
    var UT = (T - lngHour + 24) % 24;
    return UT;
  }
  return { sunriseUTC: calc(true), sunsetUTC: calc(false) };
}

function utcHourToLocalString(dateObj, utcHour, tz){
  if(utcHour === null) return '—';
  var h = Math.floor(utcHour);
  var m = Math.round((utcHour - h) * 60);
  if(m === 60){ m = 0; h += 1; }
  var d = new Date(Date.UTC(dateObj.getUTCFullYear(), dateObj.getUTCMonth(), dateObj.getUTCDate(), h, m));
  return d.toLocaleTimeString('en-US', { hour:'numeric', minute:'2-digit', timeZone: tz });
}

function moonPhase(dateObj){
  var lp = 2551443;
  var newMoonRef = Date.UTC(2000,0,6,18,14,0) / 1000;
  var phase = ((dateObj.getTime()/1000 - newMoonRef) % lp) / lp;
  if(phase < 0) phase += 1;
  var names = ['New Moon','Waxing Crescent','First Quarter','Waxing Gibbous','Full Moon','Waning Gibbous','Last Quarter','Waning Crescent'];
  var emojis = ['🌑','🌒','🌓','🌔','🌕','🌖','🌗','🌘'];
  var idx = Math.floor(phase * 8 + 0.5) % 8;
  return { name: names[idx], emoji: emojis[idx] };
}

