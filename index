async function fetchWeatherLoc(loc, attempt){
  attempt = attempt || 0;
  var url = 'https://api.open-meteo.com/v1/forecast?latitude='+loc.lat+'&longitude='+loc.lon+'&daily=temperature_2m_max,temperature_2m_min,precipitation_probability_max,weathercode&temperature_unit=fahrenheit&timezone=auto&forecast_days=16';
  try {
    var res = await fetch(url);
    if(!res.ok) throw new Error('HTTP '+res.status);
    var data = await res.json();
    if(!data || !data.daily) throw new Error('malformed response');
    return data;
  } catch(e){
    if(attempt < 2){
      await new Promise(function(r){ setTimeout(r, 500 + attempt*700); });
      return fetchWeatherLoc(loc, attempt+1);
    }
    console.error('weather fetch failed for loc after 3 attempts', loc, e);
    return {failed:true};
  }
}

function getWeatherCache(){
  try { return JSON.parse(localStorage.getItem('ak_weather_cache') || '{}'); } catch(e){ return {}; }
}
function setWeatherCache(cache){
  try { localStorage.setItem('ak_weather_cache', JSON.stringify(cache)); } catch(e){}
}

var _weatherRefreshInProgress = false;
async function refreshAkWeather(){
  if(_weatherRefreshInProgress){
    var statusElBusy = document.getElementById('ak-weather-status');
    if(statusElBusy) statusElBusy.textContent = 'Still refreshing from your last tap — hang tight…';
    return;
  }
  _weatherRefreshInProgress = true;
  var statusEl = document.getElementById('ak-weather-status');
  if(statusEl) statusEl.textContent = 'Fetching live forecast…';
  var uniqueLocs = [];
  AK_WEATHER_DAYS.forEach(function(d){
    if(!uniqueLocs.find(function(u){return u.lat===d.lat && u.lon===d.lon;})) uniqueLocs.push({lat:d.lat, lon:d.lon});
  });
  var cache = getWeatherCache();
  var results = {};
  try {
    await Promise.all(uniqueLocs.map(async function(loc){
      var key = loc.lat+','+loc.lon;
      var data = await fetchWeatherLoc(loc, 0);
      if(data && data.failed && cache[key]){
        results[key] = cache[key];
        results[key]._stale = true;
      } else {
        results[key] = data;
        if(!data.failed){ cache[key] = data; }
      }
    }));
    setWeatherCache(cache);
    var anyFound = false;
    var anyFailed = false;
    var anyStale = false;
    AK_WEATHER_DAYS.forEach(function(d, i){
      var data = results[d.lat+','+d.lon];
      var slot = document.getElementById('wxlive-'+i);
      var slotHtml;
      if(data && data.failed){
        anyFailed = true;
        slotHtml = '<div class="wxi">⚠️</div><div class="wxh">—</div><div class="wxr">Fetch failed</div>';
      } else {
        var idx = data && data.daily ? data.daily.time.indexOf(d.date) : -1;
        if(idx > -1){
          anyFound = true;
          if(data._stale) anyStale = true;
          var hi = Math.round(data.daily.temperature_2m_max[idx]);
          var lo = Math.round(data.daily.temperature_2m_min[idx]);
          var pop = data.daily.precipitation_probability_max[idx];
          var icon = wxIconFor(data.daily.weathercode[idx]);
          var staleTag = data._stale ? ' <span style="opacity:.6;font-size:8px">(cached)</span>' : '';
          slotHtml = '<div class="wxi">'+icon+'</div><div class="wxh">'+hi+'°/'+lo+'°F</div><div class="wxr">'+pop+'% rain'+staleTag+'</div>';
        } else {
          slotHtml = '<div class="wxi">—</div><div class="wxh">—</div><div class="wxr">Not yet</div>';
        }
      }
      if(slot) slot.innerHTML = slotHtml;
    });
    renderPortDayWeather(results);
    hidePastWeatherDays();
    if(statusEl){
      if(anyFailed){
        statusEl.textContent = '⚠️ Some locations failed after 3 tries (real network issue) — tap Refresh to retry; other days shown are accurate.';
      } else if(anyStale){
        statusEl.textContent = '✓ Showing mostly live data — a couple locations used cached data from your last successful check due to a network hiccup.';
      } else {
        statusEl.textContent = anyFound
          ? '✓ Live forecast as of just now — greyed-out days are still too far out (check back closer to those dates)'
          : 'Still too early — none of these dates are in forecast range yet. Try again in a few days.';
      }
    }
  } catch(e){
    if(statusEl) statusEl.textContent = '⚠️ Couldn\'t fetch live weather — check your connection and try again.';
    console.error('weather fetch failed', e);
  } finally {
    _weatherRefreshInProgress = false;
  }
}

