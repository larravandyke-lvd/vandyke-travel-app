  lv:'You are the warm, knowledgeable AI travel concierge inside Larra and Eric Van Dyke\'s personal trip dashboard, for their Las Vegas birthday trip (now archived/completed). Pre-departure night at Westfields Marriott Washington Dulles Jul 7. Wynn Las Vegas Jul 8-12 2026. Larra\'s birthday is July 8. Flights UA1323 IAD 8:15AM ET to LAS 10:24AM PT Jul 8. Jul 10 11AM Wizard of Oz at Sphere, Section 305 Row 6 Seats 20 and 21 — Big Bus to TI or Resorts World then walk through Venetian. Jul 10 4:45PM SHARP Lip Smacking Foodie Tour, MGM Grand Gold Lion, order RYG7FDN, $998, stops Craftsteak, Morimoto, Chez Bippy speakeasy. Jul 11 UFC 329. Big Bus 48-hr ticket Jul 9-11. Speakeasies: Employees Only LV, Laundry Room, Velveteen Rabbit, Herbs and Rye, The Griffin, The Underground at The Mob Museum. They love chef tasting menus and omakase. Answer concisely and specifically, referencing real details from the trip above when relevant. If asked about something not covered here, say so honestly rather than inventing specifics like reservation times or confirmation numbers.',
  ak:'You are the warm, knowledgeable AI travel concierge inside Larra and Eric Van Dyke\'s personal trip dashboard, for their Alaska cruise on Celebrity Edge, Sky Suite 9195 Deck 9, reservation 2328245, sailing Seattle round-trip Aug 14-21 2026 (Ketchikan, Juneau, Skagway, Victoria BC). Their travel advisor is Christina "Linnea" Bart at Creative Escapes, 770-403-9720. OBC was $1,550 and has been fully spent on excursions. Gratuities were prepaid. Unlimited Specialty Dining package. Excursions booked: Ketchikan UTV Safari + Crab 9:30AM; Juneau Helicopter + Mendenhall Glacier 4:45PM; Skagway Ocean Raft Wildlife Adventure 9AM; Victoria Hop-On Hop-Off 6:30PM (dock 5:30PM). They love chef tasting menus and omakase, and want to book Chef\'s Table onboard. Answer concisely and specifically, referencing real details above when relevant — e.g. port logistics, what to wear, timing between excursions, restaurant picks. If asked about something not covered here, say so honestly rather than inventing specifics like reservation times or confirmation numbers.',
  dn:'You are the warm, knowledgeable AI travel concierge inside Larra and Eric Van Dyke\'s personal trip dashboard, for their Danube River cruise on Celebrity Compass, Vista Balcony Suite 215 Deck 2, reservation 2474293, sailing Budapest to Vilshofen (near Munich) Aug 19-26 2027, one-way. Their travel advisor is Christina "Linnea" Bart at Creative Escapes, 770-403-9720. All meals, premium drinks, wifi, and one excursion per day are included. Vienna overnight days 4-5. Planning assumes Pre-Stay in Budapest (Kempinski, alt. Al Habtoor, both on Erzsebet ter) and Post-Stay in Prague (Mandarin Oriental, alt. Marriott). Gratuities prepaid at $161/person. Top restaurant picks: Steirereck Vienna (2 Michelin stars, book months ahead), Mraz & Sohn Vienna (1 Michelin, omakase-style), Borkonyha Budapest (1 Michelin), Szimpla Kert ruin bar. They love chef tasting menus and omakase. Answer concisely and specifically. If asked about something not covered here (e.g. final hotel picks, flights — nothing booked yet), say so honestly rather than inventing details.'
};
var QSUG={
  lv:['What should we do on our free afternoon?','Best speakeasy near MGM Grand?','What should Larra wear for her birthday dinner?'],
  ak:['What should we wear in Ketchikan?','How much time between the helicopter tour and dinner?','Any tips for Chef\'s Table?'],
  dn:['Kempinski or Al Habtoor in Budapest?','What should we book ahead in Vienna?','Best way to spend our Vienna overnight?']
};
var CHAT_HIST={lv:[],ak:[],dn:[]};
(function(){['lv','ak','dn'].forEach(function(t){
  try{var raw=localStorage.getItem('lvd_chat_'+t);if(raw)CHAT_HIST[t]=JSON.parse(raw);}catch(e){}
});})();
function ceEsc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function ceSaveHist(trip){try{localStorage.setItem('lvd_chat_'+trip,JSON.stringify(CHAT_HIST[trip]));}catch(e){}}
function renderConcierge(trip){
  var panel=document.getElementById(trip+'-concierge');
  if(!panel)return;
  var qsugHtml=QSUG[trip].map(function(q){return '<div class="tp" style="display:inline-block;margin:0 6px 6px 0;font-size:11.5px;padding:7px 12px" onclick="askC(\''+trip+'\',\''+q.replace(/'/g,"\\'")+'\')">'+ceEsc(q)+'</div>';}).join('');
  panel.innerHTML =
    '<div class="sec">'
    + '<div class="sh"><div class="st">🤖 AI Concierge</div><span style="font-size:16px;cursor:pointer" onclick="toggleKeySettings(\''+trip+'\')">⚙️</span></div>'
    + '<div class="tip-box" id="'+trip+'-key-banner" style="'+(apiKey?'display:none':'')+'">'
    +   '<div class="tip-lbl">Connect your Anthropic API key</div>'
    +   '<div class="tip-txt">This runs on your own Anthropic API key, called directly from the browser — nothing routes through a server, and the key is stored only on this device (not synced). Because it\'s a direct browser call, the key is technically visible to anyone with access to this browser\'s dev tools, so only use a key you\'re comfortable having on a personal device. Get one at <span style="text-decoration:underline">console.anthropic.com</span> → API Keys.</div>'
    +   '<div style="display:flex;gap:6px;margin-top:8px">'
    +     '<input id="'+trip+'-key-input" type="text" inputmode="text" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" name="lvd-notpassword-'+trip+'" placeholder="sk-ant-..." style="flex:1;padding:9px 10px;border-radius:10px;border:2px solid var(--b);font-size:13px;-webkit-text-security:disc;text-security:disc" value="'+ceEsc(apiKey)+'">'
    +     '<button class="tp" style="background:var(--ac);color:white;border-color:var(--ac)" onclick="saveKey(\''+trip+'\')">Save</button>'
    +   '</div>'
    + '</div>'
    + '<div class="tip-box" id="'+trip+'-key-active" style="'+(apiKey?'':'display:none')+';border-color:#22c55e;background:rgba(34,197,94,.08)">'
    +   '<div class="tip-lbl" style="color:#166534">✓ Concierge active on this device</div>'
    +   '<div class="tip-txt">Ask anything about this trip below. <span style="text-decoration:underline;cursor:pointer" onclick="forgetKey()">Remove saved key</span></div>'
    + '</div>'
    + '<div class="card" style="padding:10px"><div id="'+trip+'-chat-msgs" style="display:flex;flex-direction:column;gap:8px;max-height:52vh;overflow-y:auto;padding:2px"></div></div>'
    + '<div style="margin-top:8px" id="'+trip+'-qsug">'+qsugHtml+'</div>'
    + '<div style="display:flex;gap:6px;margin-top:8px">'
    +   '<input id="'+trip+'-ci" placeholder="Ask about this trip…" style="flex:1;padding:11px 12px;border-radius:12px;border:2px solid var(--b);font-size:13px" onkeypress="if(event.key===\'Enter\'){event.preventDefault();sendC(\''+trip+'\');}">'
    +   '<button class="tp" style="background:var(--ac);color:white;border-color:var(--ac);padding:0 16px" onclick="sendC(\''+trip+'\')">Send</button>'
    + '</div>'
    + '<div style="text-align:right;margin-top:6px"><span style="font-size:11px;color:var(--tm);cursor:pointer;text-decoration:underline" onclick="clearChat(\''+trip+'\')">Clear conversation</span></div>'
    + '</div>';
  renderChatMsgs(trip);
}
function renderChatMsgs(trip){
  var wrap=document.getElementById(trip+'-chat-msgs');
  if(!wrap)return;
  if(!CHAT_HIST[trip].length){
    wrap.innerHTML='<div style="font-size:12.5px;color:var(--tm);text-align:center;padding:14px">Ask me anything about this trip — timing, what to wear, restaurant picks, logistics between stops.</div>';
    return;
  }
  wrap.innerHTML=CHAT_HIST[trip].map(function(m){
    var mine=m.role==='user';
    return '<div style="align-self:'+(mine?'flex-end':'flex-start')+';max-width:85%;background:'+(mine?'var(--ac)':'var(--acb)')+';color:'+(mine?'white':'var(--text)')+';padding:9px 12px;border-radius:14px;'+(mine?'border-bottom-right-radius:4px':'border-bottom-left-radius:4px')+';font-size:13.5px;line-height:1.5;white-space:pre-wrap">'+ceEsc(m.content)+'</div>';
  }).join('');
  wrap.scrollTop=wrap.scrollHeight;
}
function askC(trip,q){
  var inp=document.getElementById(trip+'-ci');
  if(inp)inp.value=q;
  sendC(trip);
}
function clearChat(trip){
  if(!CHAT_HIST[trip].length)return;
  if(!confirm('Clear this conversation?'))return;
  CHAT_HIST[trip]=[];
  ceSaveHist(trip);
  renderChatMsgs(trip);
}
function sendC(trip){
  var inp=document.getElementById(trip+'-ci');
  var q=inp?inp.value.trim():'';
  if(!q)return;
  if(!apiKey){
    var b=document.getElementById(trip+'-key-banner');
    if(b)b.style.display='';
    return;
  }
  CHAT_HIST[trip].push({role:'user',content:q});
  inp.value='';
  renderChatMsgs(trip);
  var wrap=document.getElementById(trip+'-chat-msgs');
  var thinking=document.createElement('div');
  thinking.id=trip+'-thinking';
  thinking.style.cssText='align-self:flex-start;max-width:85%;background:var(--acb);color:var(--tm);padding:9px 12px;border-radius:14px;border-bottom-left-radius:4px;font-size:13.5px;font-style:italic';
  thinking.textContent='Thinking…';
  wrap.appendChild(thinking);
  wrap.scrollTop=wrap.scrollHeight;
  fetch('https://api.anthropic.com/v1/messages',{
    method:'POST',
    headers:{
      'Content-Type':'application/json',
      'x-api-key':apiKey,
      'anthropic-version':'2023-06-01',
      'anthropic-dangerous-direct-browser-access':'true'
    },
    body:JSON.stringify({
      model:'claude-sonnet-4-6',
      max_tokens:1024,
      system:CTX[trip],
      messages:CHAT_HIST[trip].map(function(m){return {role:m.role,content:m.content};})
    })
  })
  .then(function(r){
    if(!r.ok){return r.json().then(function(e){throw new Error((e.error&&e.error.message)||('API error '+r.status));});}
    return r.json();
  })
  .then(function(data){
    var txt=data.content&&data.content.find(function(b){return b.type==='text';});
    CHAT_HIST[trip].push({role:'assistant',content:txt?txt.text:'No response received.'});
    ceSaveHist(trip);
    renderChatMsgs(trip);
  })
  .catch(function(err){
    CHAT_HIST[trip].push({role:'assistant',content:'⚠️ '+(err.message||'Something went wrong — check your API key and try again.')});
    renderChatMsgs(trip);
  });
}
</script>
</body>
</html>