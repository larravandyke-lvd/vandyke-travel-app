var FB_CONFIG_KEY = 'lvd_fb_config';
var fbApp = null, fbDb = null, fbDocRef = null, fbReady = false;
var FB_EXCLUDE_KEYS = ['lvd_authed', 'lvd_api_key', 'lvd_fb_config'];

function fbIsSyncableKey(key) {
  if (FB_EXCLUDE_KEYS.indexOf(key) > -1) return false;
  if (key.indexOf('lvd_photos_') === 0) return false;
  if (key.indexOf('lvd_') !== 0) return false;
  return true;
}

function fbInit() {
  if (fbReady) return true;
  var cfgStr = localStorage.getItem(FB_CONFIG_KEY);
  if (!cfgStr) return false;
  try {
    var cfg = JSON.parse(cfgStr);
    if (typeof firebase === 'undefined') return false;
    fbApp = firebase.apps && firebase.apps.length ? firebase.apps[0] : firebase.initializeApp(cfg);
    fbDb = firebase.firestore();
    fbDocRef = fbDb.collection('vandyke_sync').doc('shared_data');
    fbReady = true;
    return true;
  } catch (e) {
    console.error('Firebase init failed', e);
    fbSetStatus('⚠️ Sync setup error — check your config');
    return false;
  }
}

var fbPushTimers = {};
function fbPushKey(key, rawStringValue) {
  if (!fbIsSyncableKey(key)) return;
  if (!fbInit()) return;
  clearTimeout(fbPushTimers[key]);
  fbPushTimers[key] = setTimeout(function () {
    var patch = {};
    patch[key] = rawStringValue;
    fbSetStatus('Syncing…');
    fbDocRef.set(patch, { merge: true }).then(function () {
      fbSetStatus('✓ Synced');
    }).catch(function (e) {
      console.error('sync push failed', e);
      fbSetStatus('⚠️ Sync failed — check connection');
    });
  }, 500);
}

var fbUnsubscribe = null;
function fbPullAndListen() {
  if (!fbInit()) { fbSetStatus('Sync not set up'); return; }
  fbSetStatus('Connecting…');
  if (fbUnsubscribe) { fbUnsubscribe(); fbUnsubscribe = null; }
  fbUnsubscribe = fbDocRef.onSnapshot(function (doc) {
    if (doc.exists) {
      fbApplyRemoteData(doc.data());
      fbSetStatus('✓ Synced · live');
    } else {
      fbSetStatus('✓ Connected (no shared data yet)');
    }
  }, function (err) {
    console.error('sync listen failed', err);
    fbSetStatus('⚠️ Sync connection error');
  });
}

function fbApplyRemoteData(data) {
  Object.keys(data).forEach(function (key) {
    if (!fbIsSyncableKey(key)) return;
    try {
      var current = localStorage.getItem(key);
      var incoming = data[key];
      if (current !== incoming) {
        localStorage.setItem(key, incoming);
      }
    } catch (e) {}
  });
  try {
    if (data.hasOwnProperty('lvd_dining_res')) {
      DINING_RES = JSON.parse(localStorage.getItem('lvd_dining_res') || '{}');
    }
  } catch (e) {}
  fbRefreshAllSyncedUI();
}

