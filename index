function renderLetterDays(){
  var list = document.getElementById('letter-days-list');
  if(!list) return;
  var now = new Date();
  var days = LETTER_DATA.days.slice();
  var unlocked = days.filter(function(d){ return now >= new Date(d.unlock); });
  var locked = days.filter(function(d){ return now < new Date(d.unlock); });
  unlocked.sort(function(a,b){ return new Date(b.unlock) - new Date(a.unlock); });
  var ordered = unlocked.concat(locked);
  var html = '';
  ordered.forEach(function(d){
    var isLocked = now < new Date(d.unlock);
    if(isLocked){
      html += '<div class="lday locked" id="lday-'+d.id+'">'
        + '<div class="lday-hdr">'
        + '<div class="lday-l"><div class="lday-date">'+d.date+'</div><div class="lday-label">'+d.label+'</div><div class="lday-lock-txt">\ud83d\udd12 Unlocks '+d.unlockDisplay+'</div></div>'
        + '</div></div>';
    } else {
      html += '<div class="lday" id="lday-'+d.id+'">'
        + '<div class="lday-hdr" onclick="toggleLDay(\''+d.id+'\')">'
        + '<div class="lday-l"><div class="lday-date">'+d.date+'</div><div class="lday-label">\ud83d\udc8c '+d.label+'</div></div>'
        + '<div class="lday-chev" id="lchev-'+d.id+'">\u25bc</div>'
        + '</div>'
        + '<div class="lday-body" id="lbody-'+d.id+'"><div class="lday-body-inner">'+d.note+'<div class="lday-sign">'+LETTER_DATA.signoff+'</div></div></div>'
        + '</div>';
    }
  });
  list.innerHTML = html;
}

function toggleLDay(id){
