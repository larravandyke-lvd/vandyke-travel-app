function fightId(section, i) { return 'ufcfight_' + section + '_' + i; }

function fightWithOverride(f, id) {
  var ov = lvdGet('lvd_data_' + id, null);
  if (!ov) return f;
  var merged = JSON.parse(JSON.stringify(f));
  if (ov.f1odds !== undefined) merged.f1.odds = ov.f1odds;
  if (ov.f2odds !== undefined) merged.f2.odds = ov.f2odds;
  if (ov.f1fav !== undefined) merged.f1.fav = ov.f1fav;
  if (ov.f2fav !== undefined) merged.f2.fav = ov.f2fav;
  if (ov.result) merged.result = ov.result;
  return merged;
}

