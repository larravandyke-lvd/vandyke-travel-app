function updateWatchClock(){
  var navBtn = document.getElementById('ak-watch-nb');
  var target = nextWatchTarget();
  var isDone = !target.time;
  if(navBtn){
    var wasOn = navBtn.classList.contains('on');
    navBtn.style.display = isDone ? 'none' : '';
    if(isDone && wasOn){
      // The countdown/reveal sequence is fully spent — nothing left to watch for.
      // Bounce off this tab to the itinerary rather than leaving Eric stranded on a dead screen.
      var itinBtn = document.querySelector('#ak-nav .nb[onclick*="itinerary"]');
      akP('itinerary', itinBtn);
    }
  }
  var panel = document.getElementById('ak-watch');
  if(!panel || !panel.classList.contains('on')) return;
  var clockEl = document.getElementById('watch-clock');
  var teaserEl = document.getElementById('watch-teaser');
  if(!clockEl || !teaserEl) return;
  var target = nextWatchTarget();
  teaserEl.textContent = pickWatchVariant(WATCH_TEASERS[target.key] || WATCH_TEASERS['done']);
  var watchCard = document.getElementById('watch-card');
  if(watchCard) watchCard.style.setProperty('--wa', WATCH_COLORS[target.key] || WATCH_COLORS['done']);
  if(target.key !== _watchIconKey){
    buildWatchIcons(target.key);
    _watchIconKey = target.key;
  }
  renderSkyAndHoroscope();
  if(!target.time){
    clockEl.innerHTML = '<div class="watch-unit"><div class="watch-num">🎉</div><div class="watch-lbl">All unlocked</div></div>';
    return;
  }
  var now = new Date();
  var diff = target.time - now;
  if(diff < 0) diff = 0;
  var d = Math.floor(diff / 86400000);
  var h = Math.floor((diff % 86400000) / 3600000);
  var m = Math.floor((diff % 3600000) / 60000);
  var s = Math.floor((diff % 60000) / 1000);
  clockEl.innerHTML =
    '<div class="watch-unit"><div class="watch-num">'+d+'</div><div class="watch-lbl">Days</div></div>'
    + '<div class="watch-unit"><div class="watch-num">'+h+'</div><div class="watch-lbl">Hrs</div></div>'
    + '<div class="watch-unit"><div class="watch-num">'+m+'</div><div class="watch-lbl">Min</div></div>'
    + '<div class="watch-unit"><div class="watch-num">'+s+'</div><div class="watch-lbl">Sec</div></div>';
}

