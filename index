function buildDeckSVG(zones){
  var n = zones.length, w = 320, h = 46, segW = w/n;
  var rects = '';
  zones.forEach(function(z,i){
    var fill = z.highlight ? 'var(--ac)' : 'var(--acb)';
    var txtFill = z.highlight ? 'white' : 'var(--ac)';
    rects += '<rect x="'+(i*segW+1)+'" y="0" width="'+(segW-2)+'" height="'+h+'" rx="6" fill="'+fill+'" stroke="var(--b)" stroke-width="1"/>';
    rects += '<text x="'+(i*segW+segW/2)+'" y="'+(h/2+5)+'" font-size="13" font-weight="800" text-anchor="middle" fill="'+txtFill+'">'+(i+1)+(z.highlight?' \u2605':'')+'</text>';
  });
  var svg = '<svg viewBox="0 0 '+w+' '+h+'" width="100%" height="'+h+'" xmlns="http://www.w3.org/2000/svg">'+rects+'</svg>';
  var legend = '<div class="deck-legend">';
  zones.forEach(function(z,i){
    var bg = z.highlight ? 'var(--ac)' : 'var(--acb)';
    var fg = z.highlight ? 'white' : 'var(--ac)';
    legend += '<div style="display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--ts);margin-top:4px">'
      + '<span style="display:inline-flex;flex-shrink:0;align-items:center;justify-content:center;width:16px;height:16px;border-radius:4px;background:'+bg+';color:'+fg+';font-weight:800;font-size:9px">'+(i+1)+'</span>'
      + (z.highlight?'<strong>':'') + z.l + (z.highlight?'</strong>':'')
      + '</div>';
  });
  legend += '</div>';
  return '<div class="deck-svg-wrap">'+svg+legend+'</div>';
}

