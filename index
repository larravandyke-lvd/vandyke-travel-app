var pkDragState = null;
function startPkDrag(e, pkEl){
  e.preventDefault();
  var rect = pkEl.getBoundingClientRect();
  var ghost = document.createElement('div');
  ghost.className = 'pk-drag-ghost';
  ghost.textContent = pkEl.querySelector('.pkt') ? pkEl.querySelector('.pkt').textContent : 'Item';
  ghost.style.left = rect.left + 'px';
  ghost.style.top = rect.top + 'px';
  ghost.style.width = rect.width + 'px';
  document.body.appendChild(ghost);
  pkEl.classList.add('pk-dragging');
  pkDragState = { el: pkEl, ghost: ghost, offsetX: e.clientX - rect.left, offsetY: e.clientY - rect.top, lastTarget: null };
  document.addEventListener('pointermove', movePkDrag);
  document.addEventListener('pointerup', endPkDrag, { once: true });
}
function movePkDrag(e){
  if(!pkDragState) return;
  pkDragState.ghost.style.left = (e.clientX - pkDragState.offsetX) + 'px';
  pkDragState.ghost.style.top = (e.clientY - pkDragState.offsetY) + 'px';
  pkDragState.ghost.style.display = 'none';
  var under = document.elementFromPoint(e.clientX, e.clientY);
  pkDragState.ghost.style.display = '';
  var catDiv = under ? under.closest('.pcats > div') : null;
  if(pkDragState.lastTarget && pkDragState.lastTarget !== catDiv){
    pkDragState.lastTarget.classList.remove('pk-cat-target');
  }
  if(catDiv && catDiv.closest('.pk-sec') === pkDragState.el.closest('.pk-sec')){
    catDiv.classList.add('pk-cat-target');
    pkDragState.lastTarget = catDiv;
  } else {
    pkDragState.lastTarget = null;
  }
}
function endPkDrag(e){
  if(!pkDragState) return;
  document.removeEventListener('pointermove', movePkDrag);
  var state = pkDragState;
  pkDragState = null;
  state.ghost.remove();
  state.el.classList.remove('pk-dragging');
  if(state.lastTarget){
    state.lastTarget.classList.remove('pk-cat-target');
    var pkSec = state.el.closest('.pk-sec');
    var txt = state.el.querySelector('.pkt') ? state.el.querySelector('.pkt').textContent : '';
    var newCat = state.lastTarget.dataset.cat;
    state.lastTarget.appendChild(state.el);
    if(pkSec){
      lvdSet('lvd_pkcat_' + pkSec.id + '_' + pkSlug(txt), newCat);
    }
  }
}
