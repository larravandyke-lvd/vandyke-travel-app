function nextWatchTarget(){
  var now = new Date();
  var tabUnlock = new Date(LETTER_DATA.tabUnlock);
  if(now < tabUnlock){
    var nowMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate());
    var unlockMidnight = new Date(tabUnlock.getFullYear(), tabUnlock.getMonth(), tabUnlock.getDate());
    var daysUntil = Math.round((unlockMidnight - nowMidnight) / 86400000);
    var key = daysUntil <= 0 ? 'pre-0' : (daysUntil === 1 ? 'pre-1' : 'pre-2');
    return {time: tabUnlock, key: key};
  }
  var days = LETTER_DATA.days.slice().sort(function(a,b){ return new Date(a.unlock) - new Date(b.unlock); });
  for(var i=0;i<days.length;i++){
    var t = new Date(days[i].unlock);
    if(now < t) return {time: t, key: days[i].id};
  }
  return {time: null, key: 'done'};
}

