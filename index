    fbReady = false; fbApp = null; fbDb = null; fbDocRef = null;
    fbSetStatus('Sync not set up');
    return;
  }
  try {
    JSON.parse(val); // validate it's real JSON before saving
    localStorage.setItem(FB_CONFIG_KEY, val);
    fbReady = false; fbApp = null; fbDb = null; fbDocRef = null;
    fbPullAndListen();
    if (statusEl) statusEl.textContent = '✓ Saved! Connecting…';
  } catch (e) {
    if (statusEl) statusEl.textContent = '⚠️ That doesn\'t look like valid JSON — double check you copied the whole config object.';
  }
}


