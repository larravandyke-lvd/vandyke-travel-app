function renderPhotoPool(trip, who){
  var container = document.getElementById(trip + '-photopool-' + who);
  if (!container) return;
  var ns = 'outfit_pool_' + trip + '_' + who;
  var photos = lvdPhotos(ns);
  if (!photos.length) {
    container.innerHTML = '<div style="font-size:11px;color:var(--tm);padding:6px">No unsorted photos yet — tap "Upload Photos to Outfit Bank" below.</div>';
    return;
  }
  container.innerHTML = photos.map(function(src, idx){
    return '<div class="pool-thumb" data-ns="' + ns + '" data-idx="' + idx + '" onpointerdown="startPoolDrag(event, this)"><img src="' + src + '"></div>';
  }).join('');
}
var poolDragState = null;
function startPoolDrag(e, thumbEl){
  e.preventDefault();
  var rect = thumbEl.getBoundingClientRect();
  var ghost = document.createElement('div');
  ghost.className = 'pool-drag-ghost';
  ghost.innerHTML = thumbEl.innerHTML;
  ghost.style.left = rect.left + 'px';
  ghost.style.top = rect.top + 'px';
  document.body.appendChild(ghost);
  thumbEl.classList.add('dragging');
  poolDragState = {
    thumbEl: thumbEl, ghost: ghost,
    offsetX: e.clientX - rect.left, offsetY: e.clientY - rect.top,
    ns: thumbEl.dataset.ns, idx: parseInt(thumbEl.dataset.idx, 10),
    lastTarget: null
  };
  document.addEventListener('pointermove', movePoolDrag);
  document.addEventListener('pointerup', endPoolDrag, { once: true });
}
function movePoolDrag(e){
  if (!poolDragState) return;
  poolDragState.ghost.style.left = (e.clientX - poolDragState.offsetX) + 'px';
  poolDragState.ghost.style.top = (e.clientY - poolDragState.offsetY) + 'px';
  poolDragState.ghost.style.display = 'none';
  var under = document.elementFromPoint(e.clientX, e.clientY);
  poolDragState.ghost.style.display = '';
  var slotEl = under ? under.closest('.outfit-slot') : null;
  if (poolDragState.lastTarget && poolDragState.lastTarget !== slotEl) {
    poolDragState.lastTarget.classList.remove('pool-drop-target');
  }
  if (slotEl) {
    slotEl.classList.add('pool-drop-target');
    poolDragState.lastTarget = slotEl;
  } else {
    poolDragState.lastTarget = null;
  }
}
function endPoolDrag(e){
  if (!poolDragState) return;
  document.removeEventListener('pointermove', movePoolDrag);
  var state = poolDragState;
  poolDragState = null;
  state.ghost.remove();
  state.thumbEl.classList.remove('dragging');
  if (state.lastTarget) {
    state.lastTarget.classList.remove('pool-drop-target');
    var slotEl = state.lastTarget;
    var targetNs = 'outfit_' + slotEl.dataset.trip + '_' + slotEl.dataset.who + '_' + slotEl.dataset.di + '_' + slotEl.dataset.si;
    var poolPhotos = lvdPhotos(state.ns);
    var src = poolPhotos[state.idx];
    if (src !== undefined) {
      poolPhotos.splice(state.idx, 1);
      lvdSet('lvd_photos_' + state.ns, poolPhotos);
      var targetPhotos = lvdPhotos(targetNs);
      targetPhotos.push(src);
      lvdSet('lvd_photos_' + targetNs, targetPhotos);
      var parts = state.ns.split('_');
      renderPhotoPool(parts[2], parts[3]);
      renderOutfitSlotUI(slotEl, targetNs);
    }
  }
}

