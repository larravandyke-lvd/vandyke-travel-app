function dayOfYear(dateObj){
  var start = new Date(dateObj.getFullYear(), 0, 0);
  return Math.floor((dateObj - start) / 86400000);
}

var _skyDate = null;
function renderSkyAndHoroscope(){
  var now = new Date();
  var dateStr = now.getFullYear()+'-'+pad2(now.getMonth()+1)+'-'+pad2(now.getDate());
  if(dateStr === _skyDate) return;
  _skyDate = dateStr;
  var el = document.getElementById('watch-sky');
  if(!el) return;

  var loc = DEFAULT_SUN_LOC;
  for(var i=0;i<SUN_LOCATIONS.length;i++){
    if(SUN_LOCATIONS[i].date === dateStr){ loc = SUN_LOCATIONS[i]; break; }
  }
  var sun = calcSunTimes(now, loc.lat, loc.lon);
  var sunriseStr = utcHourToLocalString(now, sun.sunriseUTC, loc.tz);
  var sunsetStr = utcHourToLocalString(now, sun.sunsetUTC, loc.tz);
  var moon = moonPhase(now);

  var doy = dayOfYear(now);
  var cancerLine = HOROSCOPES.cancer[doy % HOROSCOPES.cancer.length];
  var aquariusLine = HOROSCOPES.aquarius[doy % HOROSCOPES.aquarius.length];

  var html = '<div class="watch-sky-row">'
    + '<div class="sky-chip"><div class="sky-chip-icon">🌅</div><div class="sky-chip-val">'+sunriseStr+'</div><div class="sky-chip-lbl">Sunrise</div></div>'
    + '<div class="sky-chip"><div class="sky-chip-icon">🌇</div><div class="sky-chip-val">'+sunsetStr+'</div><div class="sky-chip-lbl">Sunset</div></div>'
    + '<div class="sky-chip"><div class="sky-chip-icon">'+moon.emoji+'</div><div class="sky-chip-val">'+moon.name+'</div><div class="sky-chip-lbl">'+loc.label+'</div></div>'
    + '</div>'
    + '<div class="watch-horo-title">🔮 Daily Horoscope</div>'
    + '<div class="horo-row">'
    + '<div class="horo-item"><div class="horo-sign">♋ Cancer</div><div class="horo-txt">'+cancerLine+'</div></div>'
    + '<div class="horo-item"><div class="horo-sign">♒ Aquarius</div><div class="horo-txt">'+aquariusLine+'</div></div>'
    + '</div>';
  el.innerHTML = html;
}

